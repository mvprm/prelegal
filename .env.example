# Copy to .env and fill in. The start scripts pass .env to the Docker container, and the
# backend reads it in development (uv run --env-file ../.env ...). Never commit .env.

# Required for the AI chat (LiteLLM via OpenRouter to gpt-oss-120b on Cerebras).
# Without it the app works, but the chat answers 503.
OPENROUTER_API_KEY=

# Optional. Marks the session cookie Secure (HTTPS only). Turn on when serving over HTTPS.
# PRELEGAL_SECURE_COOKIES=true
